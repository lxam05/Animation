{
  "motif": "0.1",
  "meta": {
    "title": "Adding two vectors",
    "description": "Two arrows a and b start at the origin. b slides to the tip of a, then the sum a + b is drawn from the origin to the tip of b.",
    "tags": ["maths", "vectors", "linear-algebra", "arrows"]
  },
  "objects": [
    {"id": "ax", "type": "axes", "width": 14, "height": 8, "x_range": [-7, 7], "y_range": [-4, 4], "stroke": "#444444", "visible": true},
    {"id": "a", "type": "arrow", "start": [0, 0], "end": [3, 1], "stroke": "#fc6255", "stroke_width": 0.07},
    {"id": "b", "type": "arrow", "start": [0, 0], "end": [1, 2], "stroke": "#58c4dd", "stroke_width": 0.07},
    {"id": "sum", "type": "arrow", "start": [0, 0], "end": [4, 3], "stroke": "#ffff00", "stroke_width": 0.08},
    {"id": "la", "type": "text", "text": "a", "x": 1.8, "y": 0.2, "fill": "#fc6255", "font": "serif"},
    {"id": "lb", "type": "text", "text": "b", "x": 0.15, "y": 1.3, "fill": "#58c4dd", "font": "serif"},
    {"id": "ls", "type": "text", "text": "a + b", "x": 1.4, "y": 2.0, "fill": "#ffff00", "font": "serif"}
  ],
  "timeline": [
    {"action": "create", "target": "a"},
    {"action": "fade_in", "target": "la", "with_previous": true},
    {"action": "create", "target": "b"},
    {"action": "fade_in", "target": "lb", "with_previous": true},
    {"action": "move", "target": "b", "to": [3, 1], "duration": 1.2},
    {"action": "move", "target": "lb", "to": [4.4, 2.0], "with_previous": true, "duration": 1.2},
    {"action": "create", "target": "sum", "duration": 1.2},
    {"action": "fade_in", "target": "ls"},
    {"action": "highlight", "target": "sum"},
    {"action": "wait", "duration": 1}
  ]
}
