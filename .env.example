# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# Atlas -> your cluster -> Connect -> Drivers -> Python
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MOTIF_DB=motif

# Embeddings: Atlas -> AI Models -> create a model API key (Voyage AI models)
VOYAGE_API_KEY=
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1     (default; use https://api.voyageai.com/v1 for a voyageai.com key)
# MOTIF_EMBED_MODEL=voyage-4
# MOTIF_EMBED_DIMS=1024   (must match the vector index; re-run atlas-setup + seed if you change it)

# The model that writes scenes
ANTHROPIC_API_KEY=
# MOTIF_LLM_MODEL=claude-sonnet-5-5
# MOTIF_MAX_REPAIRS=3
# MOTIF_EXAMPLES_K=3
